    "sharp": "^0.34.5",
    "starlight-image-zoom": "0.14.2",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.28.0"
}
